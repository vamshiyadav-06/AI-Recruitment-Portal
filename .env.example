# Backend AI configuration
GROQ_API_KEY=replace_with_groq_api_key
GROQ_MODEL=openai/gpt-oss-20b

# Aiven PostgreSQL connection; backend-only
DATABASE_URL=postgresql://username:password@your-aiven-host:port/database?sslmode=require
JWT_SECRET=replace_with_a_long_random_secret

# Frontend origins allowed to call the API
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# Initial administrator, created when the backend starts
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Administrator
ADMIN_PASSWORD=replace_with_secure_admin_password

# Optional registration notifications
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=notifications@example.com
SMTP_PASSWORD=replace_with_smtp_password
